  "sourceObservations": {
    "engineer": "Short broad anatomy; simple brown workcap and one copper beard wedge. Goggles sit on cap III–VI. Front leather apron II+, long IV+, broad grey reinforcement V+, single steel chest plate VI only. One carpenter claw IV+.",
    "frostwarden": "Deep pointed hood with beige opening. One broad ivory collar II+. One continuous ice spear at all ranks. Small shield III/IV and elongated broad shield V/VI. Gloves remain brown. Shoulders VI only.",
    "stormcaller": "Bare swept back connected dark hair. No headband I. One circlet II+. Raised right casting hand, single simple cyan zigzag I–IV and one connected three-prong glyph V/VI. Long two-point cape IV+."
  },
  "inferredHiddenConstruction": {
    "frostGrip": "One brown rear shield handle, never a weapon shaft wrap. Grip anchors are inferred under the left hand.",
    "iceSpear": "PNG drawings depict a diamond head and slender cyan shaft; these are reconciled as one watertight connected ice mesh, without a socket.",
    "stormGlyph": "Front and profile PNGs show broad lightning glyph silhouettes simultaneously, incompatible with the specified fixed thin planar glyph. Notes take priority: one fixed-thickness glyph in the XZ plane, narrow in true profile, no per-camera rotation.",
    "engineerClaw": "One broad angular claw attached to hammer striking face. Its exact hidden join is inferred; no extra disconnected hammer.",
    "dwarfScale": "Authoring anatomy, cap, beard, limbs and tools share the common root scale (1.17,1.05,0.87). No rank-specific anatomy scaling."
  },
